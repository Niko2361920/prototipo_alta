# Copia este archivo como .env.local (solo en tu computador) y llena los valores.
# En Vercel estos mismos valores van en Settings -> Environment Variables.
# NUNCA subas el archivo .env.local a GitHub.

# Cadena de conexión de MongoDB Atlas (Connect -> Drivers -> Node.js).
# Reemplaza los marcadores con los datos que proporciona Atlas.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos dentro del cluster
MONGODB_DB=twoglass

# Clave larga y aleatoria para firmar las sesiones (mínimo 32 caracteres).
# Genera una distinta para cada entorno; no uses este marcador en producción.
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas

# Solo para probar en tu computador sin MongoDB: deja MONGODB_URI vacío y pon
# MONGODB_URI=memoria  -> guarda los datos en .data/memdb.json (no sirve en Vercel)
